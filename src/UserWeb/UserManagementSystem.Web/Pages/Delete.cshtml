@page "{id:int}"
@model DeleteModel
@{
    ViewData["Title"] = "Delete";
}

<h2>Delete User</h2>

<p>Are you sure you want to delete this user?</p>

<div>
    <strong>@Model.User.UserName</strong> (@Model.User.Id)
</div>

<form method="post">
    <input type="hidden" asp-for="User.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="/Users/Index" class="btn btn-secondary">Cancel</a>
</form>
