@page
@model UserManagementSystem.Web.Pages.DeshboardModel
@{
	ViewData["Title"] = "Deshboard";
}
<style>
    body {
        background: #f8f9fa;
        font-family: 'Segoe UI', sans-serif;
    }

    .sidebar {
        width: 240px;
        min-height: 100vh;
        position: fixed;
    }

        .sidebar .nav-link {
            color: #333;
            padding: 10px 15px;
            border-radius: 6px;
            margin-bottom: 5px;
        }

            .sidebar .nav-link.active,
            .sidebar .nav-link:hover {
                background: #e9ecef;
                font-weight: 500;
            }

    .main {
        margin-left: 240px;
        padding-bottom: 50px;
    }

    .timeline li {
        margin-bottom: 10px;
        font-size: 14px;
    }

</style>
<!-- Dashboard Content -->
<div class="container-fluid mt-4">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card p-3 text-center shadow-sm">
                <h6>Cash Deposits</h6>
                <h3 class="text-warning">1.7M</h3>
                <small class="text-danger">▼ 54.1% less earnings</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 text-center shadow-sm">
                <h6>Invested Dividends</h6>
                <h3 class="text-primary">9M</h3>
                <small class="text-success">▲ 14.1% growth</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 text-center shadow-sm">
                <h6>Capital Gains</h6>
                <h3 class="text-success">$563</h3>
                <small class="text-success">▲ 7.35% increased</small>
            </div>
        </div>
    </div>

    <!-- Graph + Timeline -->
    <div class="row mt-4">
        <div class="col-md-8">
            <div class="card shadow-sm p-3">
                <h6>Technical Support</h6>
                <canvas id="lineChart"></canvas>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h6>Timeline Example</h6>
                <ul class="timeline list-unstyled">
                    <li><span class="badge bg-primary">●</span> All Hands Meeting</li>
                    <li><span class="badge bg-warning">●</span> Build the production release <span class="badge bg-danger">NEW</span></li>
                    <li><span class="badge bg-success">●</span> Something not important</li>
                    <li><span class="badge bg-info">●</span> This dot has info state</li>
                </ul>
            </div>
        </div>
    </div>
</div>
</div>
</div>

<!-- Bootstrap + Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('lineChart');
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: ['Jan','Feb','Mar','Apr','May','Jun','Jul'],
        datasets: [{
          label: 'New Accounts',
          data: [10, 15, 8, 20, 18, 25, 22],
          borderColor: 'green',
          fill: false,
          tension: 0.3
        }]
      }
    });
</script>