@page
@model AddUserModel
@{
    ViewData["Title"] = "Add User";
}

<div class="container mt-4">
    <h2>Add New User</h2>
    <form method="post">
        <div class="mb-3">
            <label asp-for="User.Name" class="form-label"></label>
            <input asp-for="User.Name" class="form-control" />
            <span asp-validation-for="User.Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="User.UserName" class="form-label"></label>
            <input asp-for="User.UserName" class="form-control" />
            <span asp-validation-for="User.UserName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="User.Password" class="form-label"></label>
            <input asp-for="User.Password" type="password" class="form-control" />
            <span asp-validation-for="User.Password" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="/User" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
