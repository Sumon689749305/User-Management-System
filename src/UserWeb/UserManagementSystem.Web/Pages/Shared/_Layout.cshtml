@{
    var isLoggedIn = Context.Request.Cookies["jwtToken"] != null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UserManagementSystem.Web</title>

    <!-- Bootstrap & CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UserManagementSystem.Web.styles.css" asp-append-version="true" />

    <!-- Font Awesome (for icons) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav class="sidebar bg-white shadow-sm">
            <div class="sidebar-header p-3">
                <h4 class="fw-bold text-primary">Architect</h4>
            </div>
            <ul class="nav flex-column px-2">
               
  @if (isLoggedIn)
                {
                    <li class="nav-item"><a asp-area="" asp-page="/Deshboard" class="nav-link active"><i class="fa fa-chart-line me-2"></i>Deshboard</a></li>
                    <li class="nav-item"><a asp-area="" asp-page="/User" class="nav-link"><i class="fa fa-shopping-cart me-2"></i>Users </a></li>   
                    <li class="nav-item"><a asp-area="" asp-page="/Privacy" class="nav-link"><i class="fa fa-dollar-sign me-2"></i>Privacy</a></li>
                    <li class="nav-item"><a asp-area="" asp-page="/Index" class="nav-link"><i class="fa fa-users me-2"></i>Index</a></li>
                    <hr>
                    <li class="nav-item"><a asp-area="" asp-page="/AddUser" class="nav-link"><i class="fa fa-box me-2"></i>Registration User</a></li>
                    <li class="nav-item"><a asp-area="" asp-page="/Login" class="nav-link"><i class="fa fa-box me-2"></i>Log In</a></li>
                    <li class="nav-item"><a asp-area="" asp-page="/Logout" class="nav-link"><i class="fa fa-box me-2"></i>Log Out</a></li>
                }
                else
                {
                    <li class="nav-item"><a asp-area="" asp-page="/Deshboard" class="nav-link active"><i class="fa fa-chart-line me-2"></i>Deshboard</a></li>
                    <li class="nav-item"><a asp-area="" asp-page="/AddUser" class="nav-link"><i class="fa fa-box me-2"></i>Registration User</a></li>
                    <li class="nav-item"><a asp-area="" asp-page="/Login" class="nav-link"><i class="fa fa-box me-2"></i>Log In</a></li>
                }

            </ul>
        </nav>

        <!-- Main Content -->
        <div class="main flex-grow-1">
            <!-- Top Navbar -->
            <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm px-3">
                <a class="navbar-brand fw-bold" href="#">Portfolio Performance</a>
                <div class="ms-auto d-flex align-items-center">
                    <a href="#" class="me-3 position-relative">
                        <i class="fa fa-bell"></i>
                        <span class="badge bg-danger rounded-pill position-absolute top-0 start-100 translate-middle">4</span>
                    </a>
                    <img src="https://img.freepik.com/premium-vector/man-portrait-logo-design-silhouette-vintage-style-logo-illustration-gentlemen-logo-handsome-man_15602-3472.jpg?semt=ais_incoming&w=740&q=80" width="50" height="50" class="rounded-circle me-2" alt="Profile">
                    <span class="fw-semibold">Alina Mcloud</span>
                </div>
            </nav>

            <!-- Body -->
            <div class="container mt-3">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <!-- Footer -->
            <footer class="border-top footer text-muted mt-auto">
                <div class="container py-2">
                    &copy; 2025 - UserManagementSystem.Web -
                    <a asp-area="" asp-page="/Privacy">Privacy</a>
                </div>
            </footer>
        </div>
    </div>

    <!-- JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
